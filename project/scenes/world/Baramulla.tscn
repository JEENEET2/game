; ── Materials & Resources ─────────────────────────────────────

[sub_resource type="Shader" id="Shader_ground"]
code = "shader_type spatial;
render_mode specular_toon;
uniform vec3 albedo_color : source_color = vec3(0.24, 0.45, 0.22);
float rand(vec2 co) {
    return fract(sin(dot(co, vec2(12.9898, 78.233))) * 43758.5453);
}
void fragment() {
	float noise = rand(UV * 2000.0) * 0.04;
	float detail = sin(UV.x * 80.0) * cos(UV.y * 80.0) * 0.5 + 0.5;
	vec3 base_color = albedo_color;
	if (albedo_color.r < 0.35) {
		vec3 dirt_color = vec3(0.18, 0.12, 0.08);
		base_color = mix(dirt_color, albedo_color, step(0.35, detail));
	}
	float sparkles = 0.0;
	if (albedo_color.r > 0.7) {
		float view_dot = dot(NORMAL, VIEW);
		float r = rand(UV * 4000.0 + sin(TIME * 0.05));
		if (r > 0.994) {
			sparkles = step(0.85, view_dot) * 0.5;
		}
	}
	ALBEDO = base_color - vec3(noise) + vec3(sparkles);
	ROUGHNESS = albedo_color.r > 0.7 ? 0.35 : 0.95;
}"

[sub_resource type="ShaderMaterial" id="Mat_Ground"]
shader = SubResource("Shader_ground")

[sub_resource type="Shader" id="Shader_river"]
code = "shader_type spatial;
render_mode specular_toon;
uniform vec3 river_color : source_color = vec3(0.15, 0.5, 0.8);
uniform vec3 foam_color : source_color = vec3(0.85, 0.92, 0.98);
void fragment() {
	float flow = sin(UV.x * 25.0 + TIME * 2.5) * cos(UV.y * 25.0 + TIME * 3.0) * 0.5 + 0.5;
	float foam = step(0.78, flow);
	ALBEDO = mix(river_color, foam_color, foam * 0.25);
	METALLIC = 0.15;
	ROUGHNESS = 0.08;
	SPECULAR = 0.6;
	NORMAL_MAP = vec3(0.5 + sin(TIME * 3.0 + UV.x * 60.0) * 0.06, 0.5 + cos(TIME * 2.5 + UV.y * 60.0) * 0.06, 1.0);
}"

[sub_resource type="ShaderMaterial" id="Mat_River"]
shader = SubResource("Shader_river")

[sub_resource type="Shader" id="Shader_bridge"]
code = "shader_type spatial;
render_mode specular_toon;
uniform vec3 plank_color : source_color = vec3(0.35, 0.2, 0.1);
uniform vec3 line_color : source_color = vec3(0.15, 0.08, 0.04);
void fragment() {
	float plank = step(0.08, sin(UV.x * 50.0) * 0.5 + 0.5);
	float grain = sin(UV.y * 300.0) * 0.05 + 0.95;
	ALBEDO = mix(line_color, plank_color * grain, plank);
	ROUGHNESS = 0.85;
}"

[sub_resource type="ShaderMaterial" id="Mat_Bridge"]
shader = SubResource("Shader_bridge")

[sub_resource type="Shader" id="Shader_building"]
code = "shader_type spatial;
render_mode specular_toon;
uniform vec3 brick_color : source_color = vec3(0.4, 0.35, 0.3);
uniform vec3 mortar_color : source_color = vec3(0.25, 0.22, 0.2);
void fragment() {
	float brick_x = step(0.08, sin(UV.x * 50.0) * 0.5 + 0.5);
	float brick_y = step(0.08, sin(UV.y * 70.0) * 0.5 + 0.5);
	ALBEDO = mix(mortar_color, brick_color, brick_x * brick_y);
	ROUGHNESS = 0.9;
}"

[sub_resource type="ShaderMaterial" id="Mat_Building"]
