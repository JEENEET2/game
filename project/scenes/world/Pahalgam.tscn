[sub_resource type="Shader" id="Shader_ground"]
code = "shader_type spatial;
render_mode specular_toon;
uniform vec3 albedo_color : source_color = vec3(0.82, 0.85, 0.88);
float rand(vec2 co) {
    return fract(sin(dot(co, vec2(12.9898, 78.233))) * 43758.5453);
}
void fragment() {
	float noise = rand(UV * 2500.0) * 0.04;
	float view_dot = dot(NORMAL, VIEW);
	float r = rand(UV * 4500.0 + sin(TIME * 0.04));
	float sparkles = 0.0;
	if (r > 0.992) {
		sparkles = step(0.82, view_dot) * 0.65;
	}
	ALBEDO = albedo_color - vec3(noise) + vec3(sparkles);
	ROUGHNESS = 0.35;
	SPECULAR = 0.45;
}"

[sub_resource type="ShaderMaterial" id="Mat_Ground"]
shader = SubResource("Shader_ground")

[sub_resource type="Shader" id="Shader_ice"]
code = "shader_type spatial;
render_mode specular_toon;
uniform vec3 ice_color : source_color = vec3(0.65, 0.8, 0.95);
float rand(vec2 co) {
    return fract(sin(dot(co, vec2(12.9898, 78.233))) * 43758.5453);
}
void fragment() {
	float view_dot = dot(NORMAL, VIEW);
	float r = rand(UV * 3000.0 + sin(TIME * 0.02));
	float sparkles = step(0.998, r) * 0.4;
	ALBEDO = ice_color + vec3(sparkles);
	ROUGHNESS = 0.05;
	METALLIC = 0.25;
	SPECULAR = 0.85;
	ALPHA = mix(0.5, 0.85, step(0.5, view_dot));
}"

[sub_resource type="ShaderMaterial" id="Mat_Ice"]
shader = SubResource("Shader_ice")

[sub_resource type="Shader" id="Shader_cliff"]
code = "shader_type spatial;
render_mode specular_toon;
uniform vec3 rock_color : source_color = vec3(0.2, 0.22, 0.25);
void fragment() {
	float layer = sin(UV.y * 80.0 + sin(UV.x * 20.0)) * 0.04 + 0.96;
	ALBEDO = rock_color * layer;
	ROUGHNESS = 0.96;
}"

[sub_resource type="ShaderMaterial" id="Mat_Cliff"]
