; ── Shared Materials ──────────────────────────────────────────

[sub_resource type="Shader" id="Shader_ground"]
code = "shader_type spatial;
render_mode specular_toon;
uniform vec3 albedo_color : source_color = vec3(0.247, 0.49, 0.2);
float rand(vec2 co) {
    return fract(sin(dot(co, vec2(12.9898, 78.233))) * 43758.5453);
}
void fragment() {
	float noise = rand(UV * 1500.0) * 0.04;
	float sparkles = 0.0;
	if (albedo_color.r > 0.7) {
		float view_dot = dot(NORMAL, VIEW);
		float r = rand(UV * 4000.0 + sin(TIME * 0.05));
		if (r > 0.993) {
			sparkles = step(0.85, view_dot) * 0.6;
		}
	}
	ALBEDO = albedo_color - vec3(noise) + vec3(sparkles);
	ROUGHNESS = albedo_color.r > 0.7 ? 0.35 : 0.9;
	SPECULAR = albedo_color.r > 0.7 ? 0.4 : 0.1;
}"

[sub_resource type="ShaderMaterial" id="Mat_Ground"]
shader = SubResource("Shader_ground")

[sub_resource type="Shader" id="Shader_house"]
code = "shader_type spatial;
render_mode specular_toon;
uniform vec3 wood_color : source_color = vec3(0.35, 0.20, 0.10);
uniform vec3 gap_color : source_color = vec3(0.15, 0.08, 0.04);
uniform float log_scale = 12.0;
float rand(vec2 co) {
    return fract(sin(dot(co, vec2(12.9898, 78.233))) * 43758.5453);
}
void fragment() {
	float band = sin(UV.y * log_scale * 3.14159) * 0.5 + 0.5;
	float log_line = step(0.18, band);
	float grain = sin(UV.x * 250.0 + UV.y * 15.0) * 0.06 + 0.94;
	float noise = rand(UV * 800.0) * 0.04;
	ALBEDO = mix(gap_color, wood_color * grain - vec3(noise), log_line);
	ROUGHNESS = 0.8;
}"

[sub_resource type="ShaderMaterial" id="Mat_House"]
shader = SubResource("Shader_house")

[sub_resource type="StandardMaterial3D" id="Mat_Trunk"]
albedo_color = Color(0.25, 0.13, 0.05, 1)

[sub_resource type="StandardMaterial3D" id="Mat_Canopy"]
