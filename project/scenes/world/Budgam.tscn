; ── Materials & Resources ─────────────────────────────────────

[sub_resource type="Shader" id="Shader_ground"]
code = "shader_type spatial;
render_mode specular_toon;
uniform vec3 albedo_color : source_color = vec3(0.12, 0.22, 0.12);
float rand(vec2 co) {
    return fract(sin(dot(co, vec2(12.9898, 78.233))) * 43758.5453);
}
void fragment() {
	float noise = rand(UV * 2000.0) * 0.05;
	float detail = sin(UV.x * 100.0) * cos(UV.y * 100.0) * 0.5 + 0.5;
	vec3 base_color = albedo_color;
	if (albedo_color.r < 0.3) {
		vec3 dirt_color = vec3(0.15, 0.1, 0.06);
		base_color = mix(dirt_color, albedo_color, step(0.4, detail));
	}
	float sparkles = 0.0;
	if (albedo_color.r > 0.7) {
		float view_dot = dot(NORMAL, VIEW);
		float r = rand(UV * 4000.0 + sin(TIME * 0.05));
		if (r > 0.994) {
			sparkles = step(0.85, view_dot) * 0.5;
		}
	}
	ALBEDO = base_color - vec3(noise) + vec3(sparkles);
	ROUGHNESS = albedo_color.r > 0.7 ? 0.35 : 0.95;
}"

