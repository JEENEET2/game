; ── Shared Materials ──────────────────────────────────────────

[sub_resource type="Shader" id="Shader_ground"]
code = "
shader_type spatial;
render_mode specular_toon;
uniform vec3 stone_color : source_color = vec3(0.32, 0.32, 0.35);
uniform vec3 grout_color : source_color = vec3(0.18, 0.18, 0.2);
void fragment() {
	float grid_x = step(0.06, sin(UV.x * 120.0) * 0.5 + 0.5);
	float grid_z = step(0.06, sin(UV.y * 120.0) * 0.5 + 0.5);
	ALBEDO = mix(grout_color, stone_color, grid_x * grid_z);
	ROUGHNESS = 0.85;
}
"

[sub_resource type="ShaderMaterial" id="Mat_Ground"]
shader = SubResource("Shader_ground")

[sub_resource type="Shader" id="Shader_water"]
code = "
shader_type spatial;
render_mode specular_toon;
uniform vec3 albedo : source_color = vec3(0.05, 0.38, 0.52);
uniform vec3 albedo_deep : source_color = vec3(0.01, 0.12, 0.24);
void fragment() {
	float w1 = sin(UV.x * 30.0 + TIME * 1.2) * 0.5 + 0.5;
	float w2 = cos(UV.y * 30.0 - TIME * 1.0) * 0.5 + 0.5;
	float wave = (w1 + w2) * 0.5;
	ALBEDO = mix(albedo_deep, albedo, wave * 0.8 + 0.2);
	METALLIC = 0.1;
	ROUGHNESS = 0.08;
	SPECULAR = 0.5;
	NORMAL_MAP = vec3(0.5 + sin(TIME + UV.x*80.0)*0.08, 0.5 + cos(TIME + UV.y*80.0)*0.08, 1.0);
}
"

[sub_resource type="ShaderMaterial" id="Mat_DalLake"]
shader = SubResource("Shader_water")

[sub_resource type="Shader" id="Shader_building"]
code = "
shader_type spatial;
render_mode specular_toon;
uniform vec3 brick_color : source_color = vec3(0.42, 0.32, 0.26);
uniform vec3 mortar_color : source_color = vec3(0.55, 0.5, 0.45);
void fragment() {
	float brick_x = step(0.08, sin(UV.x * 50.0) * 0.5 + 0.5);
	float brick_y = step(0.08, sin(UV.y * 80.0) * 0.5 + 0.5);
	float grid = brick_x * brick_y;
	ALBEDO = mix(mortar_color, brick_color, grid);
	ROUGHNESS = 0.9;
}
"

[sub_resource type="ShaderMaterial" id="Mat_Building"]
shader = SubResource("Shader_building")

[sub_resource type="StandardMaterial3D" id="Mat_Stall"]
