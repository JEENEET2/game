[sub_resource type="Shader" id="Shader_cave_ground"]
code = "shader_type spatial;
render_mode specular_toon;
uniform vec3 stone_color : source_color = vec3(0.12, 0.11, 0.14);
uniform vec3 glow_color : source_color = vec3(0.65, 0.1, 0.9);
void fragment() {
	float vein1 = sin(UV.x * 25.0 + sin(UV.y * 30.0)) * 0.5 + 0.5;
	float vein2 = cos(UV.y * 20.0 + cos(UV.x * 25.0)) * 0.5 + 0.5;
	float vein = step(0.96, vein1 * vein2);
	float noise = sin(UV.x * 800.0) * cos(UV.y * 800.0) * 0.05;
	ALBEDO = mix(stone_color + vec3(noise), glow_color, vein);
	EMISSION = glow_color * vein * 2.5;
	ROUGHNESS = mix(0.9, 0.2, vein);
}"

[sub_resource type="ShaderMaterial" id="Mat_CaveGround"]
shader = SubResource("Shader_cave_ground")

[sub_resource type="Shader" id="Shader_cave_pillar"]
code = "shader_type spatial;
render_mode specular_toon;
uniform vec3 pillar_color : source_color = vec3(0.08, 0.07, 0.1);
uniform vec3 glow_color : source_color = vec3(0.65, 0.1, 0.9);
void fragment() {
	float vein_v = sin(UV.x * 15.0 + sin(UV.y * 25.0)) * 0.5 + 0.5;
	float vein = step(0.97, vein_v);
	ALBEDO = mix(pillar_color, glow_color, vein);
	EMISSION = glow_color * vein * 2.0;
	ROUGHNESS = mix(0.95, 0.3, vein);
}"

